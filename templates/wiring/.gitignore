# Datos no versionados (el repo tiene código y specs, no datasets).
/data/
/runs/
# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Datos del paso `coverage` del pipeline. El patron con sufijo cubre los
# archivos parciales que coverage deja por proceso (.coverage.<host>.<pid>.<rnd>)
# cuando la corrida se interrumpe o corre en paralelo.
.coverage
.coverage.*
htmlcov/
coverage.xml

# Configuracion local del asistente (por-usuario, no se versiona)
.claude/settings.local.json

# Puntero de sesion local del gate spec-first (SPEC-004 FR-008): se
# reescribe con cada commit y no aporta a la trazabilidad real (esa vive en
# specs/SPECS_REGISTRY.md + los FR-NNN referenciados en los tests).
.sdd/current-spec

# Testigos de conflicto de sdd-update (SPEC-025 ANA-013): la version del kit
# que quedo al lado de una plantilla editada, para fusionar a mano.
*.kit-new
