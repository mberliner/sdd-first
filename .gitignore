__pycache__/
*.pyc
.venv
.mypy_cache/
.pytest_cache/
.ruff_cache/
/data/
/runs/

# Datos del paso `coverage` del pipeline. El patron con sufijo cubre los
# archivos parciales que coverage deja por proceso (.coverage.<host>.<pid>.<rnd>)
# cuando la corrida se interrumpe o corre en paralelo.
.coverage
.coverage.*
htmlcov/
coverage.xml

# Configuración local del asistente (por-usuario, no se versiona)
.claude/settings.local.json

# Puntero de sesión local del gate spec-first (SPEC-004 FR-008): se
# reescribe con cada commit y no aporta a la trazabilidad real (esa vive en
# specs/SPECS_REGISTRY.md + los FR-NNN referenciados en los tests).
.sdd/current-spec
